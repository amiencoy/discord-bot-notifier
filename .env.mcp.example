# MCP Server Configuration for Discord Bot Notifier
# Copy to .env.mcp locally

# n8n Webhook URL (required)
N8N_WEBHOOK_URL=https://draxisdigital.app.n8n.cloud/webhook/agent-notifier

# Agent identification (optional)
AGENT_NAME=Mistral Vibe
AGENT_VARIANT=devstral

# MCP Server port (optional, default: 8080)
MCP_PORT=8080
